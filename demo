<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Phong Mouse Shop - Demo</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            margin: 0;
        }

        header {
            background: #111;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .container {
            max-width: 600px;
            margin: 30px auto;
            background: white;
            padding: 25px;
            border-radius: 15px;
        }

        .product {
            border: 1px solid #ddd;
            padding: 20px;
            border-radius: 10px;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: #111;
            color: white;
            margin-top: 10px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 7px 0;
            box-sizing: border-box;
        }

        #payment, #addressForm {
            display: none;
            margin-top: 20px;
        }

        .code {
            font-size: 22px;
            font-weight: bold;
        }
    </style>
</head>

<body>

<header>
    <h1>🖱️ PHONG MOUSE SHOP</h1>
    <p>DEMO SHOP</p>
</header>

<div class="container">

    <!-- SẢN PHẨM -->
    <div class="product">

        <h2>ATK Mouse Demo</h2>

        <p>
            Mã sản phẩm:
            <b>MOUSE001</b>
        </p>

        <p>
            Giá:
            <b>500.000đ</b>
        </p>

        <button onclick="muaHang()">
            MUA NGAY
        </button>

    </div>


    <!-- THANH TOÁN -->
    <div id="payment">

        <hr>

        <h2>💳 Thanh toán DEMO</h2>

        <p>Ngân hàng: MB Bank (DEMO)</p>

        <p>Số tài khoản:</p>

        <div class="code">
            0000000000
        </div>

        <p>Nội dung chuyển khoản:</p>

        <div class="code" id="maDon"></div>

        <p>
            Sau khi chuyển khoản, người bán kiểm tra
            và xác nhận đơn hàng.
        </p>

        <!-- DEMO nên có nút giả lập -->
        <button onclick="xacNhanDemo()">
            🧪 Giả lập người bán đã xác nhận
        </button>

    </div>


    <!-- FORM GIAO HÀNG -->
    <div id="addressForm">

        <hr>

        <h2>📦 Thông tin nhận hàng</h2>

        <input
            id="hoten"
            type="text"
            placeholder="Họ và tên"
        >

        <input
            id="sdt"
            type="tel"
            placeholder="Số điện thoại"
        >

        <input
            id="diachi"
            type="text"
            placeholder="Địa chỉ nhận hàng"
        >

        <button onclick="guiThongTin()">
            Gửi thông tin
        </button>

    </div>


    <!-- KẾT QUẢ -->
    <div id="ketqua"></div>

</div>


<script>

    let maDonHang = "";

    // Khi khách bấm mua
    function muaHang() {

        // Tạo mã đơn ngẫu nhiên
        let random = Math.floor(10000 + Math.random() * 90000);

        maDonHang = "MOUSE001-" + random;

        document.getElementById("maDon").innerText = maDonHang;

        document.getElementById("payment").style.display = "block";
    }


    // Chỉ dùng để DEMO
    function xacNhanDemo() {

        alert("✅ Người bán đã xác nhận thanh toán!");

        document.getElementById("addressForm").style.display = "block";
    }


    // Nhận thông tin giao hàng
    function guiThongTin() {

        let hoten =
            document.getElementById("hoten").value;

        let sdt =
            document.getElementById("sdt").value;

        let diachi =
            document.getElementById("diachi").value;


        // Kiểm tra có nhập đủ không
        if (hoten === "" || sdt === "" || diachi === "") {

            alert("Vui lòng nhập đầy đủ thông tin!");
            return;
        }


        document.getElementById("ketqua").innerHTML = `

            <hr>

            <h2>✅ ĐẶT HÀNG THÀNH CÔNG</h2>

            <p>
                <b>Mã đơn:</b>
                ${maDonHang}
            </p>

            <p>
                <b>Người nhận:</b>
                ${hoten}
            </p>

            <p>
                <b>Số điện thoại:</b>
                ${sdt}
            </p>

            <p>
                <b>Địa chỉ:</b>
                ${diachi}
            </p>
        `;
    }

</script>

</body>
</html>
